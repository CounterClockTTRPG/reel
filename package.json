{
  "name": "reel",
  "version": "0.1.0",
  "description": "A studio for narrated tour and tutorial videos of web applications, recorded from scripts.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "reel": "dist/cli/main.js"
  },
  "exports": {
    "./adapter": {
      "types": "./dist/adapter/api.d.ts",
      "default": "./dist/adapter/api.js"
    },
    "./lib/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "playwright test -c tests/ui/playwright.config.ts",
    "dev": "vite web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "commander": "^15.1.0",
    "fastify": "^5.12.8",
    "music-metadata": "^12.8.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
