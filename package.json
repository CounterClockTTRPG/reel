{
  "name": "reel",
  "version": "0.1.0",
  "description": "A studio for narrated tour and tutorial videos of web applications, recorded from scripts.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "reel": "dist/cli/main.js"
  },
  "exports": {
    "./adapter": "./dist/adapter/api.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:ui": "playwright test -c tests/ui/playwright.config.ts",
    "dev": "vite web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "commander": "^15.1.0",
    "fastify": "^5.12.8",
    "music-metadata": "^12.8.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
